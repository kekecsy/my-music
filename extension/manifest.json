{
  "manifest_version": 3,
  "name": "local music · B站收藏",
  "version": "1.0.0",
  "description": "逛 B 站时一键把音乐视频收藏到本地音乐库 local music，支持多P合集整辑收藏。",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "contextMenus", "activeTab"],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "*://*.bilibili.com/*",
    "*://b23.tv/*"
  ],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "local music · B站收藏",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["*://*.bilibili.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
