# 统一行尾，避免 Windows 上双击 .bat 出问题
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.sh  text eol=lf
*.py  text eol=lf
*.js  text eol=lf
*.css text eol=lf
*.html text eol=lf
*.json text eol=lf
*.md  text eol=lf
*.yml text eol=lf

# 二进制资源不做行尾转换
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.db binary
*.woff2 binary
